# ============================================================
# Docker 沙盒環境變數（docker compose 專用，與正式 .env 完全分開）
# ============================================================
# 用途：docker compose up 起的容器**絕不能**碰正式 .env 裡的 Neon 雲端 DB /
# 真實 Alpaca 金鑰 / Discord webhook——那會讓沙盒容器當成第二個排程 leader
# 去接手正式的 Bot 艦隊（已實測炸過：容器一開機就 resume 190+ 個真實 Bot、
# Discord 打到 429）。這份檔案只給 docker-compose.yml 讀，刻意留白 + 全部
# 自動化排程關閉，開機後是乾淨的空 DB，什麼都不會跑。
#
# 用法：cp .env.docker.example .env.docker（.env.docker 已 gitignore）
# 想測 Alpaca 連線可自行填 Paper 金鑰，其餘欄位不建議改。

# --- 資料庫：強制本機 SQLite（容器內 volume，與正式 Neon 完全隔離） ---
DATABASE_URL=sqlite:////app/data/albee_stock.db

# --- Alpaca：留空即可，smoketest 不需要；要測帳戶查詢再自行填 Paper 金鑰 ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALLOW_LIVE_TRADING=false

# --- 通知：留空，沙盒不對外發通知 ---
DISCORD_WEBHOOK_URL=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- 全部自動化排程關閉：沙盒只驗證「服務起得來」，不要背景跑掃描/回測/部署 ---
CATCHUP_ON_BOOT=false
LEADER_BACKTEST_ENABLED=false
TRADE_REVIEW_ENABLED=false
AUTO_DEPLOY_ENABLED=false
AUTO_DEPLOY_KNOWLEDGE_ENABLED=false
BOT_REVIEW_ENABLED=false
DISCOVERY_ENABLED=false
AUTO_VALIDATE_ENABLED=false
COLLECTOR_INTERVAL_MIN=0
SCAN_INTERVAL_MIN=0
POLITICAL_ENABLED=false

# --- LLM 助手：預設關（容器內沒有 Ollama 可連） ---
LLM_BASE_URL=
