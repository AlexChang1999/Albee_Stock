# ============================
# Alpaca API 設定
# ============================
# 請到 https://app.alpaca.markets 註冊並取得 API Key
# Paper Trading（模擬交易）用 paper-api，Live Trading 用 api
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================
# 資料源（Phase 6）
# ============================
# 抓 K 線的資料源，回測與實盤共用同一個設定（消滅「回測用 A、實盤用 B」的分岔）。
# 可選 alpaca（預設）或 yfinance（免費）。留空 = alpaca。
DATA_SOURCE=alpaca

# 回測成本模型（Phase 6 step-02）：讓回測 EV 誠實，單位 basis point（bps，萬分之一）。
# 手續費（Alpaca 美股免佣，預設 0）；滑價（市價單實際成交的價差，預設 5 bps 保守估）。
BACKTEST_COMMISSION_BPS=0
BACKTEST_SLIPPAGE_BPS=5

# 樣本外驗證（Phase 6 step-04）：optimizer 海選挑冠軍 / 自動部署門檻一律看「樣本外（OOS）」EV。
# 歷史切「訓練段 / 測試段」，這是測試段（時間軸後段）佔比。⚠️ 同一個 AUTO_DEPLOY_EV_THRESHOLD
# 現在卡的是 OOS EV，比樣本內更難達到——這是對的（過擬合的策略本來就該被擋）。
OOS_TEST_RATIO=0.3

# ============================
# 實盤交易安全閥（真錢防線）
# ============================
# 預設 false：即使上面網址改成實盤(真錢)，系統仍會拒絕送出真錢單。
# 只有在你「真的要用真錢自動交易」時，才把它設成 true，
# 而且要同時把 ALPACA_BASE_URL 改成實盤網址（https://api.alpaca.markets）。
# ⚠️ 開啟後機器人會用真錢自動下單，請先在 Paper 模式充分驗證策略與止盈止損！
ALLOW_LIVE_TRADING=false

# ============================
# LINE 通知設定（Messaging API）
# ============================
# 請到 LINE Developers Console 建立 Messaging API Channel
# 註：LINE Notify 已於 2025 年停止服務，改用 Messaging API 推播
LINE_CHANNEL_ACCESS_TOKEN=your_line_token_here
LINE_CHANNEL_SECRET=your_line_secret_here
# 你的 LINE user id（推播訊息的對象）
LINE_USER_ID=your_line_user_id_here

# ============================
# Discord 通知設定（選用）
# ============================
# 到 Discord 頻道「設定 → 整合 → 建立 Webhook」複製網址貼上即可。
# 留空 = 不啟用 Discord 通知（程式照常運作）。不需任何套件或機器人權限。
DISCORD_WEBHOOK_URL=

# ============================
# 即時報價推送（選用）
# ============================
# 後端每隔幾秒向 Alpaca 拉一次最新成交價，再用 WebSocket 推給前端。
# 數字越小越即時、但越耗 Alpaca REST 額度。留空 = 預設 5 秒。
QUOTE_POLL_INTERVAL_SEC=5

# ============================
# LLM 思考助手（Phase 5，選用）— OpenAI 相容介面，可切換供應商
# ============================
# 換供應商只改下面三行，程式不用動。預設指向本機 Ollama（完全免費）。
# 留空 LLM_BASE_URL = 不啟用助手（/chat 回 400 提示，其餘功能照常運作）。
#
# 【Ollama 本機，預設，完全免費】先裝 https://ollama.com，再 `ollama pull llama3.1`
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
#
# 外送閘（隱私安全閥，預設關）：助手會把策略方案/回測歷史/探討筆記注入 prompt。
# LLM_BASE_URL 指向「外部雲端」時，這些資料就會送出本機。預設只允許本機 localhost；
# 要用下面 Gemini/Groq 等雲端供應商，必須一併把這行設成 true（等於同意資料外送）。
LLM_ALLOW_CLOUD=false
#
# 【Google Gemini 免費層】到 https://aistudio.google.com 取得免費 key 後改成：
# （雲端供應商，記得同時 LLM_ALLOW_CLOUD=true 才會放行）
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=你的_Gemini_key
# LLM_MODEL=gemini-2.0-flash
#
# 【Groq 免費層】到 https://console.groq.com 取得免費 key 後改成：
# （雲端供應商，記得同時 LLM_ALLOW_CLOUD=true 才會放行）
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=你的_Groq_key
# LLM_MODEL=llama-3.3-70b-versatile

# ===== AI 策略探勘 / 漏斗式篩選（改版 Phase 2）=====
# 盤前海選的候選股池（逗號分隔）。漏斗第一層先用量價粗篩，第二層才動用本機 Ollama。
SCREENER_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,AMD,NFLX,INTC
# 第一層量能門檻：最新成交量 > 近 20 日均量 × 此倍數，才算「爆量」入選。
SCREENER_VOLUME_RATIO=2.5
# 第一層最多放幾檔進第二層（控制 LLM 呼叫次數，建議 5~10）。
SCREENER_TOP_N=8

# ===== 全自動護欄 / 模式 B 自動部署（改版 Phase 4）=====
# 「自動駕駛」：盤前自動跑海選，EV + 勝率同時超標就無人工確認自動建 Bot。風險最高，預設關。
# 與實盤雙閘獨立：開這個 ≠ 開實盤，自動建的 Bot 仍預設 Paper。確定要才設 true。
AUTO_DEPLOY_ENABLED=false
# 雙重門檻（兩個都要過）：EV 絕對期望值、勝率百分比。
AUTO_DEPLOY_EV_THRESHOLD=150
AUTO_DEPLOY_WINRATE_THRESHOLD=55
# 最多同時自動建幾個 Bot（防一次梭哈）、每個配多少資金。
AUTO_DEPLOY_MAX_BOTS=5
AUTO_DEPLOY_CASH_PER_BOT=1000
# 盤前掃描的本機時刻（24 小時制的「時」）。
AUTO_DEPLOY_HOUR=8
