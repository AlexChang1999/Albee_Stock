# ============================
# Alpaca API 設定
# ============================
# 請到 https://app.alpaca.markets 註冊並取得 API Key
# Paper Trading（模擬交易）用 paper-api，Live Trading 用 api
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================
# 資料庫（雲端 Neon PostgreSQL）
# ============================
# 多台電腦共用同一份資料（回測歷史/bots/決策 log），換機零搬遷。
# 連線字串到 Neon Dashboard → Connect 複製（含 ?sslmode=require）。
# 留空 / 整行註解掉 = 自動退回本機 SQLite（albee_stock.db），App 照常能跑。
# 完整設定 / 換機 runbook：docs/guides/setup-postgres-sync.md
DATABASE_URL=postgresql://neondb_owner:你的密碼@ep-xxxx.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ============================
# 資料源（Phase 6）
# ============================
# 抓 K 線的資料源，回測與實盤共用同一個設定（消滅「回測用 A、實盤用 B」的分岔）。
# 可選 alpaca（預設）或 yfinance（免費）。留空 = alpaca。
DATA_SOURCE=alpaca

# Alpaca 資料 API 限流（免費版約 200 req/min 的保險絲）。批次抓取後請求數已大降，
# 額度內零延遲、超量才等。0 = 不限流（測試 / 付費方案用）。留空 = 200。
ALPACA_RATE_LIMIT_PER_MIN=200

# 並行抓取的執行緒數：給「只能逐筆打」的 I/O 用（FRED 多序列、RSS 多 feed）。
# 批次 API（一次請求抓多檔 K 線 / 報價）不需要這個。留空 = 4。
FETCH_MAX_WORKERS=4

# 回測成本模型（Phase 6 step-02）：讓回測 EV 誠實，單位 basis point（bps，萬分之一）。
# 手續費（Alpaca 美股免佣，預設 0）；滑價（市價單實際成交的價差，預設 5 bps 保守估）。
BACKTEST_COMMISSION_BPS=0
BACKTEST_SLIPPAGE_BPS=5

# 樣本外驗證（Phase 6 step-04）：optimizer 海選挑冠軍 / 自動部署門檻一律看「樣本外（OOS）」EV。
# 歷史切「訓練段 / 測試段」，這是測試段（時間軸後段）佔比。⚠️ 同一個 AUTO_DEPLOY_EV_THRESHOLD
# 現在卡的是 OOS EV，比樣本內更難達到——這是對的（過擬合的策略本來就該被擋）。
OOS_TEST_RATIO=0.3

# ============================
# 總經 / 環境資料（Phase 11）— FRED 聯準會經濟數據
# ============================
# 讓回測吃得到「環境因子」（非農、失業率、聯邦基金利率、CPI、公債殖利率、VIX）。
# 免費，但需自行到 https://fred.stlouisfed.org/docs/api/api_key.html 申請免費 API key。
# 留空 = 整個總經功能靜默關閉（不影響其他功能，仿 LLM 沒裝 Ollama 的優雅降級）。
FRED_API_KEY=
# 要追蹤的 FRED 序列代號（逗號分隔）。預設：非農/失業率/聯邦基金利率/CPI/10年&2年殖利率/VIX。
MACRO_SERIES=PAYEMS,UNRATE,FEDFUNDS,CPIAUCSL,DGS10,DGS2,VIXCLS
# 未知序列的「發布落差」天數預設（point-in-time 防偷看未來；已知序列的精確落差寫在程式對照表）。
MACRO_DEFAULT_LAG_DAYS=35

# ============================
# 實盤交易安全閥（真錢防線）
# ============================
# 預設 false：即使上面網址改成實盤(真錢)，系統仍會拒絕送出真錢單。
# 只有在你「真的要用真錢自動交易」時，才把它設成 true，
# 而且要同時把 ALPACA_BASE_URL 改成實盤網址（https://api.alpaca.markets）。
# ⚠️ 開啟後機器人會用真錢自動下單，請先在 Paper 模式充分驗證策略與止盈止損！
ALLOW_LIVE_TRADING=false

# ============================
# Agent Gateway — 外部 AI agent 受限存取（採納自 QuantDinger）
# ============================
# 讓 Claude / Cursor 透過 /api/agent/v1/* + 自家 MCP server（見 mcp_server/）驅動我們的
# 回測 / 策略 / 知識庫查詢，並可下「預設 paper」的單。每筆呼叫落 agent_audits 審計表。
# AGENT_API_TOKEN：bearer 密鑰，留空＝Gateway 整組關閉（端點回 503）。★絕不 commit。
# 產一把：python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=
# agent 下單能否碰真錢的「第三道閘」（鏡像 ALLOW_LIVE_TRADING）。預設 false＝agent 只能下 paper 單。
# 要 agent 動真錢須三者齊開：實盤網址 + ALLOW_LIVE_TRADING=true + 本閘=true。
AGENT_LIVE_TRADING_ENABLED=false

# ============================
# LINE 通知設定（Messaging API）
# ============================
# 請到 LINE Developers Console 建立 Messaging API Channel
# 註：LINE Notify 已於 2025 年停止服務，改用 Messaging API 推播
LINE_CHANNEL_ACCESS_TOKEN=your_line_token_here
LINE_CHANNEL_SECRET=your_line_secret_here
# 你的 LINE user id（推播訊息的對象）
LINE_USER_ID=your_line_user_id_here

# ============================
# Discord 通知設定（選用）
# ============================
# 到 Discord 頻道「設定 → 整合 → 建立 Webhook」複製網址貼上即可。
# 留空 = 不啟用 Discord 通知（程式照常運作）。不需任何套件或機器人權限。
DISCORD_WEBHOOK_URL=

# ============================
# 維運安全軌（真錢前必備）
# ============================
# ----- 券商端止損託管（H1）-----
# 開啟時 Bot 進場後把止損掛到券商端（Alpaca GTC stop / trailing stop 單），
# 電腦當機/斷網/重開機止損照樣執行（本機輪詢保留當備援）。
# 代價：保護單只支援整股 → 掛保護單的 Bot 進場股數取整、買不起 1 股會跳過。
# 預設開；設 false = 完全退回舊版純本機輪詢。
BROKER_STOP_ENABLED=true

# ----- 心跳 + dead-man switch（H2）-----
# 每日心跳日報（給人看）+ 對外側監測服務 ping（給機器看）。
# 警報必須在「系統外側」——本機死了，本機發不出「我死了」的通知。
# 到 https://healthchecks.io 免費註冊 → 建一個 check（建議 period=1 小時、grace=1 小時）
# → 複製 ping 網址貼這裡。留空 = dead-man 功能關（日報照發）。
# 設定步驟詳見 docs/guides/deadman-switch-runbook.md
HEARTBEAT_PING_URL=
# 每日心跳日報的本機時刻（24 小時制的「時」）。
HEARTBEAT_HOUR=8
# 每隔幾分鐘 ping 外側一次（建議 30，配 period=1h+grace=1h → 死超過約 2 小時必有警報）。
HEARTBEAT_PING_INTERVAL_MIN=30

# ============================
# 即時報價推送（選用）
# ============================
# 後端每隔幾秒向 Alpaca 拉一次最新成交價，再用 WebSocket 推給前端。
# 數字越小越即時、但越耗 Alpaca REST 額度。留空 = 預設 5 秒。
QUOTE_POLL_INTERVAL_SEC=5

# ============================
# LLM 思考助手（Phase 5，選用）— OpenAI 相容介面，可切換供應商
# ============================
# 換供應商只改下面三行，程式不用動。預設指向本機 Ollama（完全免費）。
# 留空 LLM_BASE_URL = 不啟用助手（/chat 回 400 提示，其餘功能照常運作）。
#
# 【Ollama 本機，預設，完全免費】先裝 https://ollama.com，再 `ollama pull llama3.1`
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
#
# 外送閘（隱私安全閥，預設關）：助手會把策略方案/回測歷史/探討筆記注入 prompt。
# LLM_BASE_URL 指向「外部雲端」時，這些資料就會送出本機。預設只允許本機 localhost；
# 要用下面 Gemini/Groq 等雲端供應商，必須一併把這行設成 true（等於同意資料外送）。
LLM_ALLOW_CLOUD=false
#
# 【Google Gemini 免費層】到 https://aistudio.google.com 取得免費 key 後改成：
# （雲端供應商，記得同時 LLM_ALLOW_CLOUD=true 才會放行）
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=你的_Gemini_key
# LLM_MODEL=gemini-2.0-flash
#
# 【Groq 免費層】到 https://console.groq.com 取得免費 key 後改成：
# （雲端供應商，記得同時 LLM_ALLOW_CLOUD=true 才會放行）
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=你的_Groq_key
# LLM_MODEL=llama-3.3-70b-versatile

# ===== AI 策略探勘 / 漏斗式篩選（改版 Phase 2）=====
# 盤前海選的候選股池（逗號分隔）。漏斗第一層先用量價粗篩，第二層才動用本機 Ollama。
SCREENER_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,AMD,NFLX,INTC
# 第一層量能門檻：最新成交量 > 近 20 日均量 × 此倍數，才算「爆量」入選。
SCREENER_VOLUME_RATIO=2.5
# 第一層最多放幾檔進第二層（控制 LLM 呼叫次數，建議 5~10）。
SCREENER_TOP_N=8

# ===== 全自動護欄 / 模式 B 自動部署（改版 Phase 4）=====
# 「自動駕駛」：盤前自動跑海選，EV + 勝率同時超標就無人工確認自動建 Bot。風險最高，預設關。
# 與實盤雙閘獨立：開這個 ≠ 開實盤，自動建的 Bot 仍預設 Paper。確定要才設 true。
AUTO_DEPLOY_ENABLED=false
# 雙重門檻（兩個都要過）：EV 絕對期望值、勝率百分比。
AUTO_DEPLOY_EV_THRESHOLD=150
AUTO_DEPLOY_WINRATE_THRESHOLD=55
# 最多同時自動建幾個 Bot（防一次梭哈）、每個配多少資金。
AUTO_DEPLOY_MAX_BOTS=5
AUTO_DEPLOY_CASH_PER_BOT=1000
# 盤前掃描的本機時刻（24 小時制的「時」）。
AUTO_DEPLOY_HOUR=8

# ===== AI 情緒閘（Phase 6 step-07）=====
# 讓第二層 LLM 的情緒分數真正影響自動部署，但守住「EV 為主、情緒為輔」。
# 總開關（預設開）；關掉 = 完全退回純 EV 行為（向後相容）。
SENTIMENT_GATING=true
# 情緒分數低於此值（或 label=bearish）視為「情緒否決」，不進自動部署。沒跑情緒視中性、不否決。
SENTIMENT_MIN_SCORE=-20

# ===== 組合層風控（Phase 6 step-05 / step-09）=====
# 資金守門（step-05）：建 Bot / 下買單前先確認帳戶付得起，且永遠保留這比例的現金緩衝（0.2 = 留 20%）。
PORTFOLIO_CASH_RESERVE_RATIO=0.2
# 回撤熔斷（step-09）：總權益從峰值回落超過此百分比 → 暫停所有新增曝險（新買進 + 自動部署），
# 但既有持倉的風控出場照常運作（只擋進、不擋出）。
PORTFOLIO_MAX_DRAWDOWN_PCT=20

# ============================
# AI 交易公司（Phase 10）
# ============================
# 常駐機會探勘（step-02）：盤中每隔幾分鐘自動跑海選、更新機會清單。0 = 關。
# 只當「首次建規則列」的種子預設，之後以前端可改的自動化規則（DB）為準。
SCAN_INTERVAL_MIN=30

# ----- 市場蒐集員 / 爬蟲收料（step-04）-----
# 定時從 RSS / 部落格收「策略描述文字」進收件匣，當人 / strategy-builder 寫成策略的素材。
# 只收料、不驗證、不部署——收回來一律過既有 OOS 閘 + 人工核准才可能上線。股價不爬。
# 逗號 / 換行分隔的 RSS 網址；留空 = 不收料（預設關，要收自己填）。
# 範例（自行確認來源服務條款）：https://www.reddit.com/r/algotrading/.rss
COLLECTOR_RSS_FEEDS=
# 每隔幾分鐘收一次；0 = 關閉常駐收料（預設關，避免無故打外站）。
COLLECTOR_INTERVAL_MIN=0
# 禮貌的 User-Agent（尊重來源、降低被封 IP 風險）。留空用內建預設。
COLLECTOR_USER_AGENT=

# ----- 探勘橋 / raw find → LLM 產候選（Phase 12 step-02）-----
# 每日定時讓本機 Ollama 讀收件匣素材，判斷在講哪種「既有」策略 + 建議參數，
# 自動產 StrategyKnowledge candidate（仍要過 OOS 閘 + 人工晉升）。不生成程式碼、不外送雲端。
# 總開關（預設 false = 不掛排程，行為與沒這功能一樣）。
DISCOVERY_ENABLED=false
# 一輪最多處理幾筆素材（防 LLM 跑整夜）。
DISCOVERY_BATCH_SIZE=5
# 每日幾點跑（24 小時制，建議盤前）。
DISCOVERY_HOUR=7

# ----- 候選自動批次驗證（Phase 12 step-03）-----
# 每日把知識庫 candidate 批次送既有 OOS 閘（判準零修改）→ validated/rejected。
# 不自動晉升 curated（人在迴路鐵則）。總開關預設 false = 不掛排程。
AUTO_VALIDATE_ENABLED=false
# 一輪最多驗幾筆（回測吃 CPU）。
AUTO_VALIDATE_BATCH_SIZE=3
# 每日幾點跑（24 小時制，建議 discovery 之後）。
AUTO_VALIDATE_HOUR=8
# 單檔相容用標的（舊欄位保留；下方籃子留空時退回它）。
AUTO_VALIDATE_SYMBOL=SPY
# ★驗證籃子（逗號分隔，跨產業）。每檔各跑 walk-forward → OOS EV 池化 → 同一支 judge。
# 留空＝退回單檔 AUTO_VALIDATE_SYMBOL。增刪標的＝改這行 + 重啟。
# 預設 38 檔：大盤指數5 / 半導體10 / 能源3 / 科技10 / 金融5 / 工業5（跳過醫療零售）。
AUTO_VALIDATE_SYMBOLS=SPY,QQQ,DIA,IWM,VTI,NVDA,AMD,AVGO,TSM,INTC,QCOM,MU,AMAT,LRCX,ASML,XOM,CVX,COP,AAPL,MSFT,GOOGL,AMZN,META,TSLA,NFLX,ADBE,CRM,ORCL,JPM,BAC,WFC,GS,MS,CAT,BA,HON,UNP,GE
# 每檔最低交易次數門檻 X：某檔所有 fold 總 num_round_trips < X → 整檔排除（避免少數幸運筆污染）。
AUTO_VALIDATE_MIN_TRADES_PER_SYMBOL=5
# 回看天數：3650≈10年(~30 folds，最難過擬合但慢)。資料源要抓得到那麼長(Alpaca免費~9年、yfinance全史)。
AUTO_VALIDATE_DAYS=3650

# ----- 知識庫策略 → 自動建 Paper Bot（curated→bot 自動部署排程）-----
# 把驗證過的好策略自動部署成 Paper Bot 掛網跑（取代手動 deploy）。預設全關，與沒這功能一樣。
# ★只建 paper bot、不碰真錢雙閘；上真錢仍須 ALPACA_BASE_URL 實盤 + ALLOW_LIVE_TRADING=true。
AUTO_DEPLOY_KNOWLEDGE_ENABLED=false
# 從哪個狀態觸發：curated(預設，保留人晉升閘最安全) 或 validated(全自動少一道人把關)。
AUTO_DEPLOY_FROM_STATUS=curated
# 部署到哪些標的（逗號分隔；knowledge 不綁標的，部署時才指定）。
AUTO_DEPLOY_KNOWLEDGE_SYMBOLS=SPY,QQQ,AAPL
# 每日幾點跑（建議排在 auto_validate 之後）。
AUTO_DEPLOY_KNOWLEDGE_HOUR=9
# 每個 Bot 下單金額（美元）。
AUTO_DEPLOY_KNOWLEDGE_TRADE_AMOUNT=1000
# 一輪最多自動部署幾筆知識（防一次建爆 Bot）。
AUTO_DEPLOY_KNOWLEDGE_MAX_PER_RUN=3
# 自動建的艦隊每幾秒輪檢行情。每筆知識部署到全部標的，好策略一多艦隊就大；拉長省 CPU/API 額度。
# （手動 deploy 仍用 60 秒預設，不受此影響。）
AUTO_DEPLOY_KNOWLEDGE_CHECK_INTERVAL=300

# ----- bot 汰弱審查員（fleet 績效考核 + 軟汰弱 + 哪股票配哪策略 fit 註冊）-----
# 自動部署讓 Bot 數＝好策略×標的數會持續長。審查員每日：算實跑績效→記 fit→軟汰弱不及格 Bot。
# ★只碰 paper bot；proposed_live/approved_live（真錢相關）一律不動。預設關。
BOT_REVIEW_ENABLED=false
# 每日幾點跑（排在 auto_deploy_knowledge 之後，先建 Bot 再有得審）。
BOT_REVIEW_HOUR=11
# 判生死的最低完整買賣次數；低於＝樣本不足、續觀察不汰。
BOT_REVIEW_MIN_ROUND_TRIPS=10
# 建立後的觀察寬限天數；沒滿不汰（給新 Bot 時間表現）。
BOT_REVIEW_MIN_AGE_DAYS=14
# 汰弱門檻（夠久夠多筆後）：勝率<此 或 報酬率<下方 或 回撤>下方 任一中 → 汰。
BOT_REVIEW_CULL_WINRATE=40
BOT_REVIEW_CULL_RETURN_PCT=0
BOT_REVIEW_CULL_MAX_DD=35
# 評「good」的勝率門檻（且報酬率為正）；good/poor 寫進 fit 表。
BOT_REVIEW_GOOD_WINRATE=55
# 一輪最多汰幾支（防門檻設錯一次誤殺整片艦隊）。
BOT_REVIEW_MAX_CULL_PER_RUN=20

# ----- 開機補跑（catch-up on boot）-----
# 家用電腦不是 24/7：每日 cron 時刻沒開機，那天管線整段跳過。
# true = 後端啟動時把「開關有開 + 時刻已過 + 今天還沒跑」的每日 job 立刻補跑。
# 不放大權限：各 job 自己的 enable 閘照常生效。
CATCHUP_ON_BOOT=true

# ----- 每日領導股回測紀錄 -----
# 每天對主要領導股各跑一輪全自動掃描（OOS EV 排名），各檔冠軍存一筆 BacktestRun。
# 只落紀錄、不下單、不建 Bot。預設開（純本機回測，無對外動作）。
LEADER_BACKTEST_ENABLED=true
# 逗號分隔的上市領導股清單（未上市公司回不了測，走下面的關鍵字監控）。
LEADER_BACKTEST_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA
# 每輪回測往前抓幾天。
LEADER_BACKTEST_DAYS=365
# 每日幾點跑（24 小時制；排在其他每日 job 之後，避免擠 CPU）。
LEADER_BACKTEST_HOUR=10

# ----- 未上市公司關鍵字監控 -----
# SpaceX 這類未上市公司沒 K 線、回不了測——collector 收料時比對關鍵字，
# 命中的素材打 watch:<關鍵字> 標籤留檔 + 通知提及。逗號分隔、不分大小寫；留空 = 關。
PRIVATE_WATCH_KEYWORDS=SpaceX

# ----- 政治專討員 / Discord 事件流（step-05）-----
# 從 Discord 頻道偵測政治貼文（例如川普發文鏡像）→ 本機 Ollama 判讀 → 接既有風險煞車。
# ★ 定位是「煞車（降風險、不開新倉），不是油門」。bridge 預設關，不影響現行下單。
# bridge 總開關（預設 false）：false = political_size_factor 一律放行 size_factor=1.0。
POLITICAL_ENABLED=false
# Discord runner 用（留空 = 不啟動 runner）。前提：先有「同步川普貼文進來的鏡像頻道」，
# 把這支 bot 拉進去拿到 token 與頻道 id。runner 獨立跑：python -m backend.bots.political_watcher
POLITICAL_DISCORD_TOKEN=
POLITICAL_CHANNEL_ID=
# 只處理這個作者名的貼文（留空 = 該頻道所有貼文）。
POLITICAL_AUTHOR_FILTER=
# 政治情緒超過幾小時就退場、不再煞車（預設 24h）。
POLITICAL_EVENT_MAX_AGE_HOURS=24
# 回補保底筆數：DB 空表時才用（只補最近 N 筆且不發通知）；正常走「時間型補齊」
# 只補比 DB 既有最新貼文更新的（0 = 關閉回補，預設 30）。
POLITICAL_BACKFILL_LIMIT=30
# 同一作者政治風險警報節流分鐘數（防來源倒貨/重判洗版；冷卻期內同作者只發一則，預設 10）。
POLITICAL_ALERT_COOLDOWN_MIN=10
